{
  "name": "@local/dsh-status-light",
  "version": "1.1.1",
  "private": true,
  "description": "Factory stack light for workspace conversations: red waits for you, amber is working, green is idle.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "YunJianFengYin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunJianFengYin/dsh-status-light.git"
  },
  "homepage": "https://github.com/YunJianFengYin/dsh-status-light#readme",
  "bugs": {
    "url": "https://github.com/YunJianFengYin/dsh-status-light/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "harness-plugin",
    "status-light",
    "notification"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
